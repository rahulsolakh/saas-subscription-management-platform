<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Admin | Subscribely</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav') %><main class="container dashboard"><div class="page-heading"><div><div class="eyebrow">ADMINISTRATION</div><h1>Admin panel</h1><p class="muted">Manage users and view basic platform statistics.</p></div><span class="status"><i></i> Administrator</span></div><% if (message) { %><div class="alert success"><%= message %></div><% } %><div class="stats-grid"><article class="stat-card"><span>Total users</span><strong><%= users.length %></strong></article><article class="stat-card"><span>Recorded revenue</span><strong>₹<%= Number(revenue).toLocaleString('en-IN') %></strong></article><article class="stat-card"><span>Active plan types</span><strong><%= subscriptions.length %></strong></article></div><section class="panel"><div class="eyebrow">USER MANAGEMENT</div><h2>Registered users</h2><div class="table-wrap"><table><thead><tr><th>Name</th><th>Email</th><th>Joined</th><th>Role</th><th>Update role</th></tr></thead><tbody><% users.forEach(user => { %><tr><td><%= user.name %></td><td><%= user.email %></td><td><%= new Date(user.created_at).toLocaleDateString('en-IN') %></td><td><%= user.role %></td><td><form class="role-form" action="/admin/users/<%= user.id %>/role" method="POST"><select name="role"><option value="user" <%= user.role === 'user' ? 'selected' : '' %>>User</option><option value="admin" <%= user.role === 'admin' ? 'selected' : '' %>>Admin</option></select><button class="button small secondary">Save</button></form></td></tr><% }) %></tbody></table></div></section><section class="panel"><div class="eyebrow">SUBSCRIPTION OVERVIEW</div><h2>Active subscriptions by plan</h2><% if (subscriptions.length) { subscriptions.forEach(item => { %><div class="mini-plan"><strong><%= item.name %></strong><span><%= item.count %> subscribers</span></div><% }) } else { %><p class="muted">No subscriptions found.</p><% } %></section></main></body></html>
