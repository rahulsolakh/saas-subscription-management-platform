<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Dashboard | Subscribely</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav') %><main class="container dashboard"><div class="page-heading"><div><div class="eyebrow">YOUR WORKSPACE</div><h1>Welcome, <%= currentUser.name %></h1><p class="muted">Here is an overview of your subscription.</p></div><span class="status"><i></i> Account active</span></div><% if (message) { %><div class="alert success"><%= message %></div><% } %><div class="stats-grid"><article class="stat-card"><span>Current plan</span><strong><%= subscription ? subscription.plan_name : 'No plan' %></strong><small>Your active subscription</small></article><article class="stat-card"><span>Monthly price</span><strong>₹<%= subscription ? Number(subscription.price).toLocaleString('en-IN') : '0' %></strong><small>Billed monthly</small></article><article class="stat-card"><span>Usage this month</span><strong><%= usage %></strong><small>Recorded actions</small></article></div><div class="two-col"><section class="panel"><div class="panel-heading"><div><div class="eyebrow">SUBSCRIPTION</div><h2>Manage your plan</h2></div></div><p class="muted">Choose a different plan whenever your needs change. In demo mode, changes are saved locally.</p><div class="mini-plans"><% plans.forEach(plan => { %><div class="mini-plan"><div><strong><%= plan.name %></strong><small>₹<%= Number(plan.price).toLocaleString('en-IN') %> / month</small></div><form action="/subscribe/<%= plan.id %>" method="POST"><button class="button small secondary">Select</button></form></div><% }) %></div></section><section class="panel"><div class="eyebrow">USAGE ANALYTICS</div><h2>Track activity</h2><p class="muted">Add a sample activity to see your usage count update.</p><form class="usage-form" action="/usage/add" method="POST"><input name="event_name" placeholder="Activity name" value="Demo action"><input type="number" name="quantity" min="1" max="100" value="1"><button class="button primary">Add usage</button></form><div class="usage-bar"><span style="width:<%= Math.min(Number(usage), 100) %>%"></span></div><small class="muted">Simple demo metric (0–100 actions)</small></section></div><section class="panel invoices"><div class="panel-heading"><div><div class="eyebrow">BILLING</div><h2>Recent invoices</h2></div></div><% if (invoices.length) { %><div class="table-wrap"><table><thead><tr><th>Invoice</th><th>Description</th><th>Date</th><th>Amount</th><th>Status</th></tr></thead><tbody><% invoices.forEach(inv => { %><tr><td>#INV-<%= inv.id %></td><td><%= inv.description %></td><td><%= new Date(inv.issued_at).toLocaleDateString('en-IN') %></td><td>₹<%= Number(inv.amount).toLocaleString('en-IN') %></td><td><span class="paid"><%= inv.status %></span></td></tr><% }) %></tbody></table></div><% } else { %><p class="muted">No invoices yet. Choose a paid plan to create a demo invoice.</p><% } %></section></main><footer>Subscribely · Internship project demo</footer></body></html>
