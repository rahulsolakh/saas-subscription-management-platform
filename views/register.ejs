<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Create account | Subscribely</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav') %><main class="auth-wrap"><form class="auth-card" method="POST" action="/register"><div class="eyebrow">GET STARTED</div><h1>Create your account</h1><% if (message) { %><div class="alert"><%= message %></div><% } %><label>Full name<input name="name" placeholder="Your name" required></label><label>Email address<input type="email" name="email" placeholder="you@example.com" required></label><label>Password<input type="password" name="password" minlength="6" placeholder="At least 6 characters" required></label><button class="button primary full">Create account</button><p class="muted center">Already registered? <a href="/login">Login</a></p></form></main></body></html>
