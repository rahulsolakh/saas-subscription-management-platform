<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Login | Subscribely</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav') %><main class="auth-wrap"><form class="auth-card" method="POST" action="/login"><div class="eyebrow">WELCOME BACK</div><h1>Login to your account</h1><% if (message) { %><div class="alert"><%= message %></div><% } %><label>Email address<input type="email" name="email" placeholder="you@example.com" required></label><label>Password<input type="password" name="password" placeholder="Your password" required></label><button class="button primary full">Login</button><p class="muted center">New here? <a href="/register">Create an account</a></p></form></main></body></html>
