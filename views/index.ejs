<!DOCTYPE html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title><%= title %> | Subscribely</title><link rel="stylesheet" href="/styles.css"></head><body><%- include('partials/nav') %><main class="container"><section class="hero"><div class="eyebrow">SIMPLE SUBSCRIPTION MANAGEMENT</div><h1>Plans that grow<br>with your business.</h1><p>Choose a plan, manage your subscription, and keep track of your usage and invoices in one simple place.</p><a class="button primary" href="/register">Create free account</a></section><section class="section-head"><div><div class="eyebrow">PRICING</div><h2>Choose your plan</h2></div><p>Simple monthly pricing. Upgrade whenever you need.</p></section><div class="plan-grid"><% plans.forEach((plan, i) => { %><article class="plan-card <%= i === 1 ? 'featured' : '' %>"><% if (i === 1) { %><span class="popular">POPULAR</span><% } %><h3><%= plan.name %></h3><p class="muted"><%= plan.description %></p><div class="price">₹<%= Number(plan.price).toLocaleString('en-IN') %><small>/ month</small></div><ul><% plan.features.forEach(feature => { %><li><span>✓</span><%= feature %></li><% }) %></ul><% if (currentUser) { %><form action="/subscribe/<%= plan.id %>" method="POST"><button class="button <%= i === 1 ? 'primary' : 'secondary' %> full">Choose <%= plan.name %></button></form><% } else { %><a class="button <%= i === 1 ? 'primary' : 'secondary' %> full" href="/register">Get started</a><% } %></article><% }) %></div><section class="note"><strong>Internship project demo:</strong> Payments are recorded in demo mode unless Stripe test credentials and a Stripe Price ID are configured.</section></main><footer>Subscribely · Internship project demo</footer></body></html>
